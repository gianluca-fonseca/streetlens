# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# Placeholders only — no real secrets.

# --- Public origin (canonical URLs, hreflang, sitemap, og:image, twitter) ---
#     `lib/site.ts` is the ONLY place the public origin is decided, and it
#     resolves in this order:
#       1. NEXT_PUBLIC_SITE_URL           this variable. Wins over everything.
#       2. VERCEL_URL                     on a PREVIEW or dev deployment only, so
#                                         a preview canonicalises to itself
#                                         instead of claiming to be production.
#       3. VERCEL_PROJECT_PRODUCTION_URL  the project's production domain,
#                                         injected by Vercel on every deployment.
#       4. https://streetlens.org         the built-in production default, used
#                                         by any production build with no Vercel
#                                         environment around it.
#       5. http://localhost:3000          `next dev` only.
#     Leave it UNSET for both local development and the real deployment: the
#     chain above already lands on the right answer. Set it when you run this
#     site on a domain of your own (a fork, a self-host, a staging box), with the
#     scheme and no trailing slash, e.g. https://streets.example.org
NEXT_PUBLIC_SITE_URL=

# --- Public map / Supabase read path ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Demo data switch (build-time DEFAULT; the map chrome switch overrides it
#     per browser via the sl_demo_data cookie) ---
#     Leave unset (or anything but "false") to publish the simulated pilot
#     scores. Set to "false" to ship a build that defaults to the real-data era.
NEXT_PUBLIC_SHOW_DEMO_DATA=

# --- Admin auth ---
ADMIN_PASSWORD=
ADMIN_RPC_SECRET=
OPS_HEALTH_SECRET=

# --- Private frame signing (0028; required for admin review + extraction pump) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Anonymous intake ---
SUBMISSIONS_IP_SALT=

# --- CV extraction (see docs/cv-funnel.md) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_VISION_ESCALATION_MODEL=
OPENAI_SYNTHESIS_MODEL=
CV_EXTRACTION_ENABLED=
CV_SYNTHESIS_MAX_ADJUST=
CV_SYNTHESIS_MAX_OUTPUT_TOKENS=
CV_INPUT_TOKEN_CEILING=
CV_SESSION_TOKENS_PER_FRAME=
CV_VEHICLE_PRIMARY_MODEL=

# --- Scheduled pump (Vercel Cron) ---
CRON_SECRET=

# --- Test isolation (optional; CI sets automatically) ---
STREETLENS_DATA_DIR=
